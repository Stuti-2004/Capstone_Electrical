// ============================================================
// LOAD CELL A
// ============================================================

HX711 scale;

const float CAL_A_DEFAULT = 756.667;
float calFactor = CAL_A_DEFAULT;

// ============================================================
// LIMITS
// ============================================================

const float MAX_WEIGHT_KG = 40.0;
const float WARN_FRACTION = 0.90;
const float OVERLOAD_MARGIN = 1.02;

const float MIN_CAL_WEIGHT_KG = 1.0;

// ============================================================
// FILTER SETTINGS - ORIGINAL V3
// ============================================================

const int MED_WIN = 3;

const int AVG_MAX = 20;
const int STEP_MIN_HISTORY = 3;
const int SIGMA_MIN_HISTORY = 6;

const float STEP_SIGMA = 4.5;
const float STEP_FLOOR_KG = 0.15;
const int STEP_CONFIRM = 2;

const float ZERO_DEADBAND_KG = 0.015;
const float ZERO_CAPTURE_KG = 0.20;
const unsigned long ZERO_DELAY_MS = 3000;
const float ZERO_TRACK_RATE = 0.01;

bool zeroTrackingOn = true;

// ============================================================
// STABILITY DETECTION - ORIGINAL V3
// ============================================================

const int STABLE_N = 20;

const float STABLE_STD_COUNTS = 70.0;
const float STABLE_DRIFT_COUNTS = 50.0;

const unsigned long TARE_TIMEOUT_MS = 30000;
const unsigned long CAL_TIMEOUT_MS = 40000;

const unsigned long WARMUP_SECONDS = 30;

// ============================================================
// TIMING
// ============================================================

const unsigned long PRINT_INTERVAL = 100;
const unsigned long SAMPLE_TIMEOUT = 2000;
const unsigned long DISPLAY_INTERVAL = 500;

unsigned long lastPrint = 0;
unsigned long lastDisplay = 0;

// ============================================================
// CLOCK SETTINGS
// ============================================================

const int initialYear = 2026;
const int initialMonth = 11;
const int initialDay = 16;
const int initialHour = 14;
const int initialMinute = 30;
const int initialSecond = 0;

// ============================================================
// CELL A FILTER STATE
// ============================================================

long medBuf[MED_WIN];
int medIdx = 0;
int medCount = 0;

long avgBuf[AVG_MAX];
int avgIdx = 0;
int avgCount = 0;

long stepVals[STEP_CONFIRM];
int stepCount = 0;
int stepSign = 0;

bool stepFlag = false;

double zeroOffset = 0.0;
double tareOffset = 0.0;

unsigned long nearZeroSince = 0;

long lastRaw = 0;
unsigned long lastSampleMs = 0;

// ============================================================
// SORT ARRAY
// ============================================================

void sortLongArray(long values[], int count)
{
  for (int i = 0; i < count - 1; i++)
  {
    for (int j = i + 1; j < count; j++)
    {
      if (values[j] < values[i])
      {
        long temp = values[i];
        values[i] = values[j];
        values[j] = temp;
      }
    }
  }
}

// ============================================================
// FILTER RESET
// ============================================================

void clearFilter()
{
  medIdx = 0;
  medCount = 0;

  avgIdx = 0;
  avgCount = 0;

  stepCount = 0;
  stepSign = 0;

  nearZeroSince = 0;
  stepFlag = false;
}

// ============================================================
// FILTER HELPERS
// ============================================================

void pushAvg(long value)
{
  avgBuf[avgIdx] = value;

  avgIdx = (avgIdx + 1) % AVG_MAX;

  if (avgCount < AVG_MAX)
  {
    avgCount++;
  }
}

double bufferMean()
{
  if (avgCount == 0) return 0.0;

  double sum = 0.0;

  for (int i = 0; i < avgCount; i++)
  {
    sum += avgBuf[i];
  }

  return sum / avgCount;
}

double bufferSigma()
{
  if (avgCount < 2) return 0.0;

  double mean = bufferMean();
  double sum = 0.0;

  for (int i = 0; i < avgCount; i++)
  {
    double d = avgBuf[i] - mean;
    sum += d * d;
  }

  return sqrt(sum / (avgCount - 1));
}

double stepThreshold()
{
  double threshold = STEP_FLOOR_KG * fabs(calFactor);

  if (avgCount >= SIGMA_MIN_HISTORY)
  {
    double adaptive = STEP_SIGMA * bufferSigma();

    if (adaptive > threshold)
    {
      threshold = adaptive;
    }
  }

  return threshold;
}

// ============================================================
// MEDIAN FILTER
// ============================================================

long medianOfWindow()
{
  long tmp[MED_WIN];

  for (int i = 0; i < medCount; i++)
  {
    tmp[i] = medBuf[i];
  }

  sortLongArray(tmp, medCount);

  return tmp[medCount / 2];
}

// ============================================================
// STEP-AWARE AVERAGE
// ============================================================

void stepAwareAverage(long m)
{
  if (avgCount < STEP_MIN_HISTORY)
  {
    pushAvg(m);
    return;
  }

  double dev = (double)m - bufferMean();

  if (fabs(dev) <= stepThreshold())
  {
    stepCount = 0;
    stepSign = 0;

    pushAvg(m);
    return;
  }

  int sign = (dev > 0) ? 1 : -1;

  if (sign != stepSign)
  {
    stepSign = sign;
    stepCount = 0;
  }

  stepVals[stepCount] = m;
  stepCount++;

  if (stepCount < STEP_CONFIRM)
  {
    return;
  }

  avgIdx = 0;
  avgCount = 0;

  for (int i = 0; i < stepCount; i++)
  {
    pushAvg(stepVals[i]);
  }

  stepCount = 0;
  stepSign = 0;

  stepFlag = true;
  nearZeroSince = 0;
}

// ============================================================
// ZERO TRACKING
// ============================================================

void updateZeroTracking()
{
  if (!zeroTrackingOn) return;

  if (avgCount < AVG_MAX)
  {
    nearZeroSince = 0;
    return;
  }

  double error = bufferMean() - zeroOffset;

  if (fabs(error) > ZERO_CAPTURE_KG * fabs(calFactor))
  {
    nearZeroSince = 0;
    return;
  }

  if (nearZeroSince == 0)
  {
    nearZeroSince = millis();
    return;
  }

  if (millis() - nearZeroSince < ZERO_DELAY_MS)
  {
    return;
  }

  zeroOffset += error * ZERO_TRACK_RATE;
}

// ============================================================
// PROCESS HX711 SAMPLE
// ============================================================

void processSample(long raw)
{
  lastRaw = raw;
  lastSampleMs = millis();

  medBuf[medIdx] = raw;

  medIdx = (medIdx + 1) % MED_WIN;

  if (medCount < MED_WIN)
  {
    medCount++;
  }

  long m = medianOfWindow();

  stepAwareAverage(m);
  updateZeroTracking();
}

// ============================================================
// WEIGHT CONVERSION
// ============================================================

bool cellKg(double &kg)
{
  if (avgCount == 0 || fabs(calFactor) < 0.001)
  {
    return false;
  }

  kg = (bufferMean() - zeroOffset) / calFactor;

  if (fabs(kg) < ZERO_DEADBAND_KG)
  {
    kg = 0.0;
  }

  return true;
}

// ============================================================
// ORIGINAL STABLE CAPTURE FUNCTION
// ============================================================
// Returns:
//  1 = stable
//  0 = timeout, mean is last window
// -1 = HX711 did not respond
// ============================================================

int waitForStableMean(
  unsigned long timeoutMs,
  double &meanOut,
  double &sdOut
)
{
  long win[STABLE_N];
  long sorted[STABLE_N];

  unsigned long start = millis();

  meanOut = 0.0;
  sdOut = 0.0;

  while (true)
  {
    for (int i = 0; i < STABLE_N; i++)
    {
      if (!scale.wait_ready_timeout(1000))
      {
        Serial.println("HX711 A timeout.");
        return -1;
      }

      win[i] = scale.read();
    }

    // Half means - slope check

    int half = STABLE_N / 2;

    double h1 = 0.0;
    double h2 = 0.0;

    for (int i = 0; i < half; i++)
    {
      h1 += win[i];
    }

    for (int i = half; i < STABLE_N; i++)
    {
      h2 += win[i];
    }

    h1 /= half;
    h2 /= (STABLE_N - half);

    // Standard deviation

    double all = 0.0;

    for (int i = 0; i < STABLE_N; i++)
    {
      all += win[i];
    }

    all /= STABLE_N;

    double var = 0.0;

    for (int i = 0; i < STABLE_N; i++)
    {
      double d = win[i] - all;
      var += d * d;
    }

    double sd = sqrt(var / (STABLE_N - 1));

    // Trimmed mean - drop 3 lowest and 3 highest

    for (int i = 0; i < STABLE_N; i++)
    {
      sorted[i] = win[i];
    }

    sortLongArray(sorted, STABLE_N);

    const int TRIM = 3;

    double total = 0.0;

    for (int i = TRIM; i < STABLE_N - TRIM; i++)
    {
      total += sorted[i];
    }

    meanOut = total / (STABLE_N - 2 * TRIM);
    sdOut = sd;

    double slope = fabs(h2 - h1);

    if (sd <= STABLE_STD_COUNTS &&
        slope <= STABLE_DRIFT_COUNTS)
    {
      return 1;
    }

    Serial.print("Waiting for stable signal: sd=");
    Serial.print(sd, 1);
    Serial.print(" slope=");
    Serial.println(slope, 1);

    if (millis() - start >= timeoutMs)
    {
      return 0;
    }
  }
}

// ============================================================
// TARE - ORIGINAL STABLE TARE APPROACH
// ============================================================

void doTare()
{
  Serial.println();
  Serial.println("--------------------------------------");
  Serial.println("TARING CELL A");
  Serial.println("--------------------------------------");

  Serial.println("Remove ALL weight.");
  Serial.println("Keep the cell completely still.");
  Serial.println();

  delay(1000);

  double mean = 0.0;
  double sd = 0.0;

  int result = waitForStableMean(
    TARE_TIMEOUT_MS,
    mean,
    sd
  );

  if (result < 0)
  {
    Serial.println("HX711 did not respond. Tare skipped.");
    return;
  }

  if (result == 0)
  {
    Serial.println("WARNING: cell never fully settled.");
    Serial.println("Zero tracking may clean up the reading.");
  }

  zeroOffset = mean;
  tareOffset = mean;

  clearFilter();

  lastSampleMs = millis();

  Serial.print("Cell A zero complete. Offset = ");
  Serial.println(mean, 1);
}

// ============================================================
// ORIGINAL CALIBRATION FUNCTION - CELL A
// ============================================================

void doCalibrate()
{
  Serial.println();

  Serial.println("--------------------------------------");
  Serial.println("CALIBRATION - CELL A");
  Serial.println("--------------------------------------");

  Serial.println("1. Remove ALL weight from cell A.");
  Serial.println("2. Keep it completely still.");
  Serial.println("3. Send any character.");

  // Clear leftover command characters
  while (Serial.available())
  {
    Serial.read();
  }

  while (!Serial.available())
  {
    delay(10);
  }

  while (Serial.available())
  {
    Serial.read();
  }

  delay(1000);

  // ZERO

  double zeroMean = 0.0;
  double sd = 0.0;

  int result = waitForStableMean(
    TARE_TIMEOUT_MS,
    zeroMean,
    sd
  );

  if (result < 0)
  {
    Serial.println("HX711 timeout during zero.");
    return;
  }

  Serial.print("Zero captured. Counts = ");
  Serial.println(zeroMean, 1);
  Serial.println();

  Serial.println("Place the known weight on cell A ONLY.");
  Serial.println("Put it in the SAME spot you will use later.");
  Serial.println("Keep it completely still.");
  Serial.println();

  Serial.print("Use between ");
  Serial.print(MIN_CAL_WEIGHT_KG, 0);
  Serial.print(" and ");
  Serial.print(MAX_WEIGHT_KG, 0);
  Serial.println(" kg (heavier = more accurate).");
  Serial.println();

  Serial.println("Enter the weight in KILOGRAMS (e.g. 20 or 12.5):");

  // KNOWN WEIGHT

  Serial.setTimeout(60000);

  float knownWeight = Serial.parseFloat();

  while (Serial.available())
  {
    Serial.read();
  }

  if (knownWeight < MIN_CAL_WEIGHT_KG)
  {
    Serial.println();
    Serial.print("Weight must be at least ");
    Serial.print(MIN_CAL_WEIGHT_KG, 0);
    Serial.println(" kg. Calibration cancelled.");
    return;
  }

  if (knownWeight > MAX_WEIGHT_KG)
  {
    Serial.println();
    Serial.print("Weight is above the ");
    Serial.print(MAX_WEIGHT_KG, 0);
    Serial.println(" kg limit. Remove it and use less.");
    Serial.println("Calibration cancelled.");
    return;
  }

  // SETTLE, THEN CAPTURE

  Serial.println();
  Serial.println("Letting the cell settle...");

  delay(5000);

  double loadedMean = 0.0;

  result = waitForStableMean(
    CAL_TIMEOUT_MS,
    loadedMean,
    sd
  );

  if (result < 0)
  {
    Serial.println("HX711 timeout during measurement.");
    return;
  }

  if (result == 0)
  {
    Serial.println("WARNING: reading never settled (creep or weight moving).");
    Serial.println("The result below may be inaccurate.");
  }

  double counts = loadedMean - zeroMean;

  if (fabs(counts) < 100.0)
  {
    Serial.println();
    Serial.println("Almost no signal change. Check wiring and that");
    Serial.println("the weight is really loading this cell.");
    Serial.println("Calibration cancelled.");
    return;
  }

  calFactor = (float)(counts / knownWeight);

  zeroOffset = zeroMean;
  tareOffset = zeroMean;

  clearFilter();

  // RESULTS

  Serial.println();
  Serial.println("--------------------------------------");
  Serial.println("CALIBRATION COMPLETE - CELL A");
  Serial.println("--------------------------------------");

  Serial.print("Known weight: ");
  Serial.print(knownWeight, 3);
  Serial.println(" kg");

  Serial.print("Signal change: ");
  Serial.print(counts, 0);
  Serial.println(" counts");

  Serial.print("New calibration factor (counts/kg): ");
  Serial.println(calFactor, 3);

  if (calFactor < 0)
  {
    Serial.println("(negative: Green/Blue are swapped; this still works)");
  }

  Serial.println();
  Serial.println("Copy this value into CAL_A_DEFAULT at the top.");
  Serial.println("Then check with a SECOND, different weight.");
  Serial.println();
}

// ============================================================
// SERIAL HELP
// ============================================================

void printHelp()
{
  Serial.println();
  Serial.println("======================================");
  Serial.println("CELL A COMMANDS");
  Serial.println("======================================");

  Serial.println("t = tare Cell A (waits for stable zero)");
  Serial.println("c = calibrate Cell A (known weight in KG)");
  Serial.println("r = raw ADC readings");
  Serial.println("z = zero tracking on/off");
  Serial.println("+ = calibration factor +1%");
  Serial.println("- = calibration factor -1%");
  Serial.println("h = help");

  Serial.print("Cell A calibration factor: ");
  Serial.println(calFactor, 3);

  Serial.print("Zero tracking: ");
  Serial.println(zeroTrackingOn ? "ON" : "OFF");

  Serial.print("Working maximum: ");
  Serial.print(MAX_WEIGHT_KG, 1);
  Serial.println(" kg");

  Serial.println();
}

// ============================================================
// RAW ADC DUMP
// ============================================================

void doRawDump()
{
  Serial.println();
  Serial.println("--------------------------------------");
  Serial.println("RAW ADC READINGS - CELL A");
  Serial.println("--------------------------------------");

  for (int n = 0; n < 20; n++)
  {
    if (scale.wait_ready_timeout(1000))
    {
      Serial.println(scale.read());
    }
    else
    {
      Serial.println("timeout");
    }
  }

  clearFilter();
  lastSampleMs = millis();
}

// ============================================================
// COMMAND HANDLER
// ============================================================

void handleCommand(char command)
{
  switch (command)
  {
    case 't':
    case 'T':
      doTare();
      break;

    case 'c':
    case 'C':
      doCalibrate();
      break;

    case 'r':
    case 'R':
      doRawDump();
      break;

    case 'z':
    case 'Z':
      zeroTrackingOn = !zeroTrackingOn;

      Serial.print("Zero tracking: ");
      Serial.println(zeroTrackingOn ? "ON" : "OFF");
      break;

    case '+':
      calFactor *= 1.01;
      clearFilter();

      Serial.print("Cell A calibration factor = ");
      Serial.println(calFactor, 3);
      break;

    case '-':
      calFactor *= 0.99;
      clearFilter();

      Serial.print("Cell A calibration factor = ");
      Serial.println(calFactor, 3);
      break;

    case 'h':
    case 'H':
      printHelp();
      break;

    default:
      break;
  }

  lastSampleMs = millis();
}

// ============================================================
// CLOCK INITIALIZATION
// ============================================================

void initializeClock()
{
  setenv("TZ", "MST7MDT,M3.2.0/2,M11.1.0/2", 1);
  tzset();

  struct tm timeinfo = {};

  timeinfo.tm_year = initialYear - 1900;
  timeinfo.tm_mon = initialMonth - 1;
  timeinfo.tm_mday = initialDay;
  timeinfo.tm_hour = initialHour;
  timeinfo.tm_min = initialMinute;
  timeinfo.tm_sec = initialSecond;

  time_t timestamp = mktime(&timeinfo);

  struct timeval tv = {
    .tv_sec = timestamp,
    .tv_usec = 0
  };

  settimeofday(&tv, nullptr);
}

// ============================================================
// OLED DISPLAY
// ============================================================

void updateDisplay()
{
  if (!oledOK || !screenOn) return;

  time_t now = time(nullptr);

  struct tm timeinfo;
  localtime_r(&now, &timeinfo);

  char timeString[20];
  char dateString[30];

  strftime(
    timeString,
    sizeof(timeString),
    "%I:%M %p",
    &timeinfo
  );

  strftime(
    dateString,
    sizeof(dateString),
    "%a, %b %d",
    &timeinfo
  );

  double kg = 0.0;
  bool valid = cellKg(kg);

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  // DATE
  display.setTextSize(1);
  display.setCursor(0, 2);
  display.println(dateString);

  // TIME
  display.setTextSize(2);
  display.setCursor(0, 18);
  display.println(timeString);

  // WEIGHT
  display.setTextSize(1);
  display.setCursor(0, 46);

  display.print("Weight: ");

  if (valid)
  {
    display.print(kg, 3);
    display.println(" kg");
  }
  else
  {
    display.println("-- kg");
  }

  display.display();
}

// ============================================================
// TOUCH SENSOR
// ============================================================

void updateTouchSensor()
{
  int touchState = digitalRead(touchPin);

  if (touchState == HIGH && lastTouchState == LOW)
  {
    screenOn = true;
    lastTouchTime = millis();

    if (oledOK)
    {
      display.ssd1306_command(SSD1306_DISPLAYON);
      updateDisplay();
    }
  }

  if (touchState == HIGH)
  {
    lastTouchTime = millis();
  }

  if (screenOn &&
      millis() - lastTouchTime >= SCREEN_TIMEOUT)
  {
    screenOn = false;

    if (oledOK)
    {
      display.ssd1306_command(SSD1306_DISPLAYOFF);
    }
  }

  lastTouchState = touchState;
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("======================================");
  Serial.println("ESP32-C3 + HX711 CELL A + OLED");
  Serial.println("Original V3 calibration and filtering");
  Serial.println("======================================");

  // Touch sensor
  pinMode(touchPin, INPUT);

  // OLED I2C
  Wire.begin(OLED_SDA, OLED_SCL);
  Wire.setClock(100000);

  oledOK = display.begin(
    SSD1306_SWITCHCAPVCC,
    OLED_ADDRESS
  );

  if (oledOK)
  {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.println("OLED connected!");
    display.display();

    delay(1000);

    display.ssd1306_command(SSD1306_DISPLAYOFF);
  }
  else
  {
    Serial.println("OLED initialization failed.");
  }

  // Clock
  initializeClock();

  // HX711
  scale.begin(A_DT_PIN, A_SCK_PIN);

  if (scale.wait_ready_timeout(2000))
  {
    Serial.println("HX711 Cell A detected.");
  }
  else
  {
    Serial.println("HX711 A NOT responding. Check wiring.");
  }

  // Warm-up
  if (WARMUP_SECONDS > 0)
  {
    Serial.print("Warming up for ");
    Serial.print((long)WARMUP_SECONDS);
    Serial.println(" seconds. Keep cell empty and still.");

    unsigned long start = millis();
    unsigned long lastMsg = start;

    while (millis() - start < WARMUP_SECONDS * 1000UL)
    {
      if (scale.is_ready())
      {
        scale.read();
      }

      if (millis() - lastMsg >= 10000)
      {
        lastMsg = millis();

        Serial.print("  ");
        Serial.print(
          (long)(WARMUP_SECONDS -
          (millis() - start) / 1000)
        );
        Serial.println(" seconds left...");
      }

      delay(5);
    }
  }

  // Initial stable tare
  doTare();

  printHelp();

  lastSampleMs = millis();
  lastTouchState = digitalRead(touchPin);
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  // Serial commands
  while (Serial.available())
  {
    char command = (char)Serial.read();

    if (command != '\n' && command != '\r')
    {
      handleCommand(command);
    }
  }

  // Touch sensor
  updateTouchSensor();

  // Non-blocking HX711 sampling
  if (scale.is_ready())
  {
    processSample(scale.read());
  }

  // Serial Plotter
  if (millis() - lastPrint >= PRINT_INTERVAL)
  {
    lastPrint = millis();

    if (avgCount > 0 && fabs(calFactor) > 0.001)
    {
      double rawKg =
        (lastRaw - zeroOffset) / calFactor;

      double filteredKg = 0.0;
      cellKg(filteredKg);

      Serial.print("Raw_kg:");
      Serial.print(rawKg, 3);

      Serial.print("\tFiltered_kg:");
      Serial.println(filteredKg, 3);
    }
  }

  // HX711 timeout warning
  if (millis() - lastSampleMs > SAMPLE_TIMEOUT)
  {
    lastSampleMs = millis();
    Serial.println("HX711 A timeout - check wiring/power.");
  }

  // OLED refresh
  if (screenOn &&
      millis() - lastDisplay >= githDISPLAY_INTERVAL)
  {
    lastDisplay = millis();
    updateDisplay();
  }
}
